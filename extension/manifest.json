{
  "manifest_version": 3,

  "name": "TabFS",
  "description": "Mount your browser tabs as a filesystem",
  "version": "1.0",

  "permissions": [
    "tabs", "tabCapture", "debugger", "nativeMessaging", "management",
    "unlimitedStorage", "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "tabfs@rsnous.com"
    }
  }
}
